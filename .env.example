# 复制为 .env。默认连接真实 CMS；独立看样式请运行 npm run dev:demo。
NUXT_CONTENT_MODE=directus
NUXT_DIRECTUS_URL=http://127.0.0.1:8055
NUXT_PUBLIC_SITE_URL=http://localhost:3000
NUXT_PUBLIC_CMS_URL=http://localhost:8055
DIRECTUS_URL=http://127.0.0.1:8055
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-long-random-password
DIRECTUS_SECRET=replace-with-at-least-32-random-characters
POSTGRES_PASSWORD=replace-with-a-different-random-password
